# Copy to .env and fill in whichever auth you have.
# Claude uses the direct API if a key is set, else falls back to Bedrock.
# Bedrock-only models (e.g. Kimi) always use AWS.

# Direct Anthropic API
ANTHROPIC_API_KEY=

# ...or AWS creds for Bedrock (SSO works too)
AWS_PROFILE=
AWS_REGION=us-east-1

# OpenAI-compatible / DeepSeek, only if you run those runners
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
