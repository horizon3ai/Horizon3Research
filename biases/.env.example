# Copy this file to `.env` and fill in the values, or export these in your shell.
# Only OPENROUTER_API_KEY is required to run the experiments.

# REQUIRED. OpenRouter API key used to query all seven models.
# Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OPTIONAL. Package root override. Defaults to the repository directory.
# DCE_ROOT=

# OPTIONAL. Set to 1 to print each model's pick per trial while running.
# DCE_VERBOSE=
